# Backend environment variables

# Database
# SQLite (local dev):
# DATABASE_URL=sqlite:///./app.db
# Postgres:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME


# For SQLite dev convenience only (tables are created automatically).
# For Postgres you should keep this false and use Alembic.
DB_AUTO_CREATE=true

# Runtime environment: dev | staging | prod
APP_ENV=prod

# Auth
# MUST be a long random string in staging/prod
# SECRET_KEY=put-a-long-random-string-here
# JWT_EXPIRE_MIN=10080

# Local dev escape hatch only (do NOT use in production)
ALLOW_INSECURE_SECRET_KEY=false

# Security / HTTP
# Comma-separated hosts that are allowed in Host header.
TRUSTED_HOSTS=127.0.0.1,localhost
# Comma-separated CORS origins for frontend apps.
CORS_ALLOW_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:8000,http://localhost:8000
# Optional regex for hosted frontends (Render/Vercel), used together with CORS_ALLOW_ORIGINS.
CORS_ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?vercel\.app$|^https://frontend-[a-z0-9-]+\.onrender\.com$
# Set true behind HTTPS in staging/prod to enable HSTS header.
HTTPS_ONLY=false

# Request & upload size limits
MAX_BODY_BYTES=5242880
MAX_AVATAR_BYTES=2097152

# Rate limits (requests per minute)
GLOBAL_RATE_LIMIT_RPM=240
AUTH_RATE_LIMIT_RPM=20
AI_RATE_LIMIT_RPM=12

# AI (optional)
# Get your key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-5-nano

# Email (optional, Resend)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Tayan <noreply@your-domain.com>

# Monitoring (optional but recommended in prod)
